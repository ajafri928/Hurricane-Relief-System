<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="6.0" prefWidth="400.0" prefHeight="760.0" stylesheets="@styles.css, @account.css"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.relief_system.ResetPasswordController">
   <padding>
      <Insets top="24.0" right="24.0" bottom="24.0" left="24.0" />
   </padding>
   <children>
      <Button text="←" styleClass="back-button" onAction="#backToLogin" />
      <Label text="Reset your password" styleClass="flow-heading">
         <VBox.margin><Insets top="16.0" /></VBox.margin>
      </Label>
      <Label text="We will send a 6 digit code to the number on your account." styleClass="flow-subheading" wrapText="true" />

      <Label text="Username or phone number" styleClass="field-heading">
         <VBox.margin><Insets top="12.0" /></VBox.margin>
      </Label>
      <TextField fx:id="identifierField" onAction="#sendCode" />
      <Button text="Send reset code" styleClass="primary-button" maxWidth="Infinity" onAction="#sendCode">
         <VBox.margin><Insets top="6.0" /></VBox.margin>
      </Button>

      <VBox fx:id="codeBox" spacing="6.0" visible="false" managed="false">
         <children>
            <VBox styleClass="info-note" spacing="2.0">
               <children>
                  <Label text="Code sent to the number on your account" styleClass="field-heading" wrapText="true" />
                  <Label text="Demo: the code is 123456." styleClass="info-note-text" />
               </children>
            </VBox>
            <Label text="6 digit code" styleClass="field-heading">
               <VBox.margin><Insets top="6.0" /></VBox.margin>
            </Label>
            <TextField fx:id="codeField" onAction="#verifyCode" />
            <Label fx:id="errorLabel" text="That code didn't match. Try again." styleClass="error-box" visible="false" managed="false" />
            <Button text="Verify code" styleClass="primary-button" maxWidth="Infinity" onAction="#verifyCode" />
            <Button text="Resend code" styleClass="link" maxWidth="Infinity" onAction="#sendCode" />
         </children>
      </VBox>

      <Region VBox.vgrow="ALWAYS" />

      <Label text="No signal? You can still request help without an account from the welcome screen."
             styleClass="info-note" wrapText="true" maxWidth="Infinity" />
      <HBox alignment="CENTER" spacing="4.0">
         <children>
            <Label text="Remember it?" styleClass="flow-subheading" />
            <Button text="Back to log in" styleClass="link" onAction="#backToLogin" />
         </children>
         <VBox.margin><Insets top="10.0" /></VBox.margin>
      </HBox>
   </children>
</VBox>
