<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox styleClass="home-root" prefWidth="400.0" prefHeight="760.0" stylesheets="@styles.css"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.relief_system.AlertsController">
   <children>
      <VBox spacing="14.0">
         <padding>
            <Insets top="28.0" right="20.0" bottom="8.0" left="20.0" />
         </padding>
         <children>
            <Label text="Alerts" styleClass="page-title" />
            <HBox spacing="8.0">
               <children>
                  <Button fx:id="allTab" text="All" styleClass="filter-tab, filter-tab-selected" maxWidth="Infinity"
                          HBox.hgrow="ALWAYS" onAction="#showAll" />
                  <Button fx:id="urgentTab" text="Urgent" styleClass="filter-tab" maxWidth="Infinity"
                          HBox.hgrow="ALWAYS" onAction="#showUrgent" />
                  <Button fx:id="myRequestTab" text="My request" styleClass="filter-tab" maxWidth="Infinity"
                          HBox.hgrow="ALWAYS" onAction="#showMyRequest" />
               </children>
            </HBox>
         </children>
      </VBox>

      <ScrollPane styleClass="home-scroll" fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS">
         <content>
            <VBox fx:id="alertsList" styleClass="home-content" spacing="10.0">
               <padding>
                  <Insets top="4.0" right="20.0" bottom="20.0" left="20.0" />
               </padding>
            </VBox>
         </content>
      </ScrollPane>

      <fx:include fx:id="nav" source="nav.fxml" />
   </children>
</VBox>