<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<VBox styleClass="home-root" prefWidth="400.0" prefHeight="760.0" stylesheets="@styles.css"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.relief_system.HomeController">
   <children>
      <ScrollPane styleClass="home-scroll" fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS">
         <content>
            <VBox styleClass="home-content" spacing="14.0">
               <padding>
                  <Insets top="28.0" right="24.0" bottom="20.0" left="24.0" />
               </padding>
               <children>

                  <VBox spacing="4.0">
                     <children>
                        <Label text="Lifeline Link" styleClass="home-brand" />
                        <Label fx:id="greetingLabel" text="Hi, Jamie" styleClass="home-greeting" />
                     </children>
                  </VBox>

                  <HBox alignment="CENTER_LEFT">
                     <children>
                        <Label text="Your safety" styleClass="safety-label" />
                        <Region HBox.hgrow="ALWAYS" />
                        <HBox fx:id="safetyBadge" styleClass="safety-badge, badge-caution" alignment="CENTER" spacing="6.0">
                           <children>
                              <SVGPath fx:id="safetyIcon" styleClass="badge-icon" content="M7 1.5 L13 12.5 H1 Z M7 5.5 V8.5 M7 10.3 V10.6" />
                              <Label fx:id="safetyText" text="Caution" styleClass="badge-text" />
                           </children>
                        </HBox>
                     </children>
                  </HBox>

                  <VBox fx:id="requestCard" styleClass="request-summary-card" spacing="10.0">
                     <children>
                        <Label fx:id="requestHeader" text="Your Active Request" styleClass="request-summary-header" />
                        <Label fx:id="requestTitle" text="Transportation - Medical Evacuation" styleClass="request-summary-title" wrapText="true" />
                        <HBox alignment="CENTER_LEFT">
                           <children>
                              <HBox fx:id="statusChip" styleClass="status-chip, chip-pending" alignment="CENTER_LEFT" spacing="8.0">
                                 <children>
                                    <SVGPath fx:id="statusIcon" styleClass="chip-icon" content="M7 1 A6 6 0 1 0 7 13 A6 6 0 1 0 7 1 Z M7 4 V7 L9.5 8.5" />
                                    <Label fx:id="statusText" text="Pending match" styleClass="chip-text" />
                                 </children>
                              </HBox>
                           </children>
                        </HBox>
                        <Label fx:id="peopleLabel" text="3 people - 1 dog" styleClass="request-summary-line" />
                        <HBox fx:id="volunteerRow" spacing="8.0" alignment="CENTER_LEFT">
                           <children>
                              <Label text="Volunteer" styleClass="request-summary-line" />
                              <Label text="→" styleClass="request-summary-line" />
                              <Label fx:id="volunteerName" text="Rosa Delgado" styleClass="request-summary-line" />
                           </children>
                        </HBox>
                        <HBox fx:id="etaRow" spacing="8.0" alignment="CENTER_LEFT">
                           <children>
                              <Label text="Estimated arrival" styleClass="request-summary-line" />
                              <Label text="→" styleClass="request-summary-line" />
                              <Label text="Not available" styleClass="request-summary-line" />
                           </children>
                        </HBox>
                        <Label fx:id="requestMessage" text="Your request is submitted. No volunteer is assigned yet."
                               styleClass="request-summary-message" wrapText="true" />
                        <Label text="View request →" styleClass="view-request-link" onMouseClicked="#handleViewRequest" />
                     </children>
                  </VBox>

                  <HBox fx:id="hurricaneCard" styleClass="hurricane-card" alignment="CENTER_LEFT" spacing="12.0">
                     <children>
                            <SVGPath styleClass="hurricane-icon"
                                 content="M7 17 H6.5 A3.5 3.5 0 0 1 6 10 A6 6 0 0 1 17.5 9.5 A3.8 3.8 0 0 1 17.5 17 H17 M12 12 V20 M9.5 17.5 L12 20 L14.5 17.5" />
                        <VBox spacing="2.0">
                           <children>
                              <Label fx:id="hurricaneName" text="Hurricane Scarlett" styleClass="hurricane-name" />
                              <Label fx:id="hurricaneStatus" text="Category 4 - Active" styleClass="hurricane-status" />
                           </children>
                        </VBox>
                     </children>
                  </HBox>

                  <VBox fx:id="noRequestSection" spacing="8.0">
                     <VBox.margin><Insets top="10.0" /></VBox.margin>
                     <children>
                        <Label text="What do you need?" styleClass="section-title" />
                        <Label text="Request help with transportation, food, shelter, and more."
                               styleClass="section-body" wrapText="true" />
                        <Button text="+  Get Help" styleClass="get-help-button" maxWidth="Infinity" onAction="#handleGetHelp">
                           <VBox.margin><Insets top="14.0" /></VBox.margin>
                        </Button>
                        <VBox styleClass="empty-card" alignment="CENTER" spacing="8.0" maxWidth="Infinity">
                           <VBox.margin><Insets top="8.0" /></VBox.margin>
                           <children>
                              <SVGPath styleClass="empty-icon" content="M6 3 H14 L19 8 V21 H6 Z M14 3 V8 H19 M9 13 H16 M9 17 H16" />
                              <Label text="No requests yet" styleClass="empty-title" />
                              <Label text="When you request help, you can check its progress here."
                                     styleClass="empty-body" wrapText="true" textAlignment="CENTER" maxWidth="230.0" />
                           </children>
                        </VBox>
                     </children>
                  </VBox>
               </children>
            </VBox>
         </content>
      </ScrollPane>

      <VBox styleClass="im-safe-bar">
         <padding>
            <Insets top="10.0" right="24.0" bottom="12.0" left="24.0" />
         </padding>
         <children>
            <Button fx:id="imSafeButton" text="I'm Safe" styleClass="secondary-button" maxWidth="Infinity" onAction="#handleImSafe" />
            <HBox fx:id="markedSafeBox" styleClass="marked-safe-box" alignment="CENTER" spacing="10.0" maxWidth="Infinity">
               <children>
                  <SVGPath styleClass="marked-safe-icon" content="M2 8.5 L6.5 13 L15 3.5" />
                  <Label text="You're marked safe" styleClass="marked-safe-text" />
               </children>
            </HBox>
         </children>
      </VBox>

      <fx:include fx:id="nav" source="nav.fxml" />
   </children>
</VBox>
