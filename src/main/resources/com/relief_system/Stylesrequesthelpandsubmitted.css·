.flow-heading {
    -fx-text-fill: #111827;
    -fx-font-size: 26px;
    -fx-font-weight: bold;
}

.flow-subheading { -fx-text-fill: #4b5563; -fx-font-size: 14px; }

.field-heading {
    -fx-text-fill: #111827;
    -fx-font-size: 14px;
    -fx-font-weight: bold;
}

.hint-icon {
    -fx-fill: transparent;
    -fx-stroke: #6b7280;
    -fx-stroke-width: 1.3;
    -fx-stroke-line-cap: round;
}

.text-area {
    -fx-background-color: #ffffff;
    -fx-border-color: #d1d5db;
    -fx-border-radius: 8;
    -fx-background-radius: 8;
    -fx-font-size: 14px;
}

.text-area:focused { -fx-border-color: #1f4e9c; -fx-border-width: 2; }

.text-area .content {
    -fx-background-color: #ffffff;
    -fx-background-radius: 8;
    -fx-padding: 6 8 6 8;
}

.primary-button:disabled { -fx-opacity: 0.45; }

.card-link {
    -fx-text-fill: #1f4e9c;
    -fx-font-size: 13px;
    -fx-font-weight: bold;
    -fx-cursor: hand;
}

.card-link:hover { -fx-underline: true; }

.danger-link {
    -fx-text-fill: #c62828;
    -fx-font-size: 14px;
    -fx-font-weight: bold;
    -fx-cursor: hand;
}

.white-card {
    -fx-background-color: #ffffff;
    -fx-border-color: #e5e7eb;
    -fx-border-radius: 10;
    -fx-background-radius: 10;
    -fx-padding: 14 16 14 16;
}

.icon-button {
    -fx-background-color: transparent;
    -fx-padding: 6;
    -fx-cursor: hand;
}

.close-icon {
    -fx-fill: transparent;
    -fx-stroke: #111827;
    -fx-stroke-width: 2;
    -fx-stroke-line-cap: round;
}

.chip-small { -fx-padding: 3 10 3 8; }

.chip-small .chip-text { -fx-font-size: 12px; }

.flow-header { -fx-background-color: #f6f8fc; }

.flow-title {
    -fx-text-fill: #111827;
    -fx-font-size: 16px;
    -fx-font-weight: bold;
}

.progress-segment {
    -fx-background-color: #e5e7eb;
    -fx-background-radius: 3;
    -fx-min-height: 5;
    -fx-pref-height: 5;
    -fx-max-height: 5;
}

.progress-done { -fx-background-color: #1f4e9c; }

.step-label {
    -fx-text-fill: #4b5563;
    -fx-font-size: 12px;
    -fx-font-weight: bold;
}

.draft-saved-icon {
    -fx-fill: transparent;
    -fx-stroke: #15803d;
    -fx-stroke-width: 1.8;
    -fx-stroke-line-cap: round;
}

.draft-saved-text { -fx-text-fill: #4b5563; -fx-font-size: 12px; }

.flow-footer { -fx-background-color: #ffffff; -fx-border-color: #e5e7eb transparent transparent transparent; }

.danger-banner {
    -fx-background-color: #fef2f2;
    -fx-border-color: #f87171;
    -fx-border-radius: 10;
    -fx-background-radius: 10;
    -fx-padding: 10 10 10 12;
}

.danger-banner-icon {
    -fx-fill: transparent;
    -fx-stroke: #c62828;
    -fx-stroke-width: 1.7;
    -fx-stroke-line-join: round;
    -fx-stroke-line-cap: round;
}

.danger-banner-title {
    -fx-text-fill: #b91c1c;
    -fx-font-size: 14px;
    -fx-font-weight: bold;
}

.danger-banner-text { -fx-text-fill: #4b5563; -fx-font-size: 12px; }

.call-911-button {
    -fx-background-color: #c62828;
    -fx-text-fill: #ffffff;
    -fx-font-weight: bold;
    -fx-background-radius: 8;
    -fx-padding: 8 12 8 10;
    -fx-graphic-text-gap: 6;
    -fx-cursor: hand;
}

.call-911-icon {
    -fx-fill: transparent;
    -fx-stroke: #ffffff;
    -fx-stroke-width: 1.4;
    -fx-stroke-line-join: round;
}

.need-tile {
    -fx-background-color: #ffffff;
    -fx-border-color: #e5e7eb;
    -fx-border-width: 1.5;
    -fx-border-radius: 12;
    -fx-background-radius: 12;
    -fx-padding: 12;
    -fx-spacing: 6;
    -fx-cursor: hand;
}

.need-tile.selected { -fx-background-color: #e6edf9; -fx-border-color: #1f4e9c; }

.need-icon-box {
    -fx-background-color: #eef2f9;
    -fx-background-radius: 8;
    -fx-min-width: 38;
    -fx-min-height: 38;
    -fx-max-width: 38;
    -fx-max-height: 38;
}

.need-tile.selected .need-icon-box { -fx-background-color: #1f4e9c; }

.need-icon {
    -fx-fill: transparent;
    -fx-stroke: #1f4e9c;
    -fx-stroke-width: 1.6;
    -fx-stroke-line-cap: round;
    -fx-stroke-line-join: round;
}

.need-tile.selected .need-icon { -fx-stroke: #ffffff; }

.need-check {
    -fx-background-color: #ffffff;
    -fx-border-color: #d1d5db;
    -fx-border-width: 1.5;
    -fx-border-radius: 11;
    -fx-background-radius: 11;
    -fx-min-width: 22;
    -fx-min-height: 22;
    -fx-max-width: 22;
    -fx-max-height: 22;
}

.need-check-mark {
    -fx-fill: transparent;
    -fx-stroke: transparent;
    -fx-stroke-width: 2;
    -fx-stroke-line-cap: round;
}

.need-tile.selected .need-check { -fx-background-color: #1f4e9c; -fx-border-color: #1f4e9c; }

.need-tile.selected .need-check-mark { -fx-stroke: #ffffff; }

.need-name {
    -fx-text-fill: #111827;
    -fx-font-size: 15px;
    -fx-font-weight: bold;
}

.need-desc { -fx-text-fill: #4b5563; -fx-font-size: 12px; }

.option-button {
    -fx-background-color: #ffffff;
    -fx-border-color: #d1d5db;
    -fx-border-radius: 10;
    -fx-background-radius: 10;
    -fx-text-fill: #111827;
    -fx-font-size: 14px;
    -fx-padding: 11 0 11 0;
    -fx-cursor: hand;
}

.option-button.selected {
    -fx-background-color: #1f4e9c;
    -fx-border-color: #1f4e9c;
    -fx-text-fill: #ffffff;
    -fx-font-weight: bold;
}

.description-area { -fx-pref-height: 96; }

.counter-name { -fx-text-fill: #111827; -fx-font-size: 14px; }

.counter-value {
    -fx-text-fill: #111827;
    -fx-font-size: 18px;
    -fx-font-weight: bold;
    -fx-min-width: 26;
    -fx-alignment: center;
}

.stepper-button {
    -fx-background-color: #ffffff;
    -fx-border-color: #d1d5db;
    -fx-border-radius: 19;
    -fx-background-radius: 19;
    -fx-min-width: 38;
    -fx-min-height: 38;
    -fx-max-width: 38;
    -fx-max-height: 38;
    -fx-font-size: 18px;
    -fx-text-fill: #1f4e9c;
    -fx-padding: 0;
    -fx-cursor: hand;
}

.stepper-plus { -fx-background-color: #e6edf9; -fx-border-color: #1f4e9c; }

.chip-option {
    -fx-background-color: #ffffff;
    -fx-border-color: #d1d5db;
    -fx-border-radius: 16;
    -fx-background-radius: 16;
    -fx-text-fill: #111827;
    -fx-font-size: 13px;
    -fx-padding: 6 14 6 14;
    -fx-cursor: hand;
}

.chip-option.selected {
    -fx-background-color: #e6edf9;
    -fx-border-color: #1f4e9c;
    -fx-text-fill: #1f4e9c;
    -fx-font-weight: bold;
}

.address-status {
    -fx-background-color: #e6edf9;
    -fx-background-radius: 10;
    -fx-padding: 12 14 12 14;
}

.address-status-text { -fx-text-fill: #1f2937; -fx-font-size: 13px; }

.location-button { -fx-graphic-text-gap: 8; }

.location-icon {
    -fx-fill: transparent;
    -fx-stroke: #1f4e9c;
    -fx-stroke-width: 1.5;
    -fx-stroke-line-cap: round;
}

.switch .box {
    -fx-background-color: #d1d5db;
    -fx-background-radius: 12;
    -fx-border-color: transparent;
    -fx-padding: 3 22 3 3;
}

.switch:selected .box { -fx-background-color: #2e7d32; -fx-padding: 3 3 3 22; }

.switch .box .mark {
    -fx-background-color: #ffffff;
    -fx-shape: "M0,8 a8,8 0 1,0 16,0 a8,8 0 1,0 -16,0";
    -fx-padding: 8;
}

.switch:selected .box .mark { -fx-background-color: #ffffff; }

.info-note {
    -fx-background-color: #e6edf9;
    -fx-background-radius: 10;
    -fx-padding: 12 14 12 14;
}

.info-note-icon {
    -fx-fill: transparent;
    -fx-stroke: #1f4e9c;
    -fx-stroke-width: 1.5;
    -fx-stroke-line-join: round;
}

.info-note-text { -fx-text-fill: #1f2937; -fx-font-size: 12px; }

.review-heading {
    -fx-text-fill: #4b5563;
    -fx-font-size: 11px;
    -fx-font-weight: bold;
}

.review-chip {
    -fx-background-color: #e6edf9;
    -fx-background-radius: 14;
    -fx-text-fill: #1f2937;
    -fx-font-size: 13px;
    -fx-padding: 5 12 5 12;
}

.review-key { -fx-text-fill: #4b5563; -fx-font-size: 13px; }

.review-value {
    -fx-text-fill: #111827;
    -fx-font-size: 13px;
    -fx-font-weight: bold;
}

.review-main { -fx-text-fill: #111827; -fx-font-size: 14px; }

.review-sub { -fx-text-fill: #6b7280; -fx-font-size: 12px; }

.urgency-chip {
    -fx-background-radius: 12;
    -fx-font-size: 12px;
    -fx-font-weight: bold;
    -fx-padding: 3 10 3 10;
    -fx-background-color: #e5e7eb;
    -fx-text-fill: #374151;
}

.urgency-low { -fx-background-color: #e6edf9; -fx-text-fill: #1f4e9c; }

.urgency-medium { -fx-background-color: #fef9c3; -fx-text-fill: #854d0e; }

.urgency-high { -fx-background-color: #fde68a; -fx-text-fill: #92400e; }

.urgency-critical { -fx-background-color: #fee2e2; -fx-text-fill: #b91c1c; }

.confirm-check { -fx-text-fill: #111827; -fx-font-size: 13px; }

.confirm-check:selected .box { -fx-background-color: #1f4e9c; }

.confirm-check:selected .mark { -fx-background-color: #ffffff; }

.modal-dim { -fx-background-color: rgba(17, 24, 39, 0.45); }

.modal-card {
    -fx-background-color: #ffffff;
    -fx-background-radius: 16;
    -fx-effect: dropshadow(gaussian, rgba(0, 0, 0, 0.25), 20, 0, 0, 4);
}

.modal-icon-circle { -fx-background-color: #fef3c7; -fx-background-radius: 24; }

.modal-icon {
    -fx-fill: transparent;
    -fx-stroke: #b45309;
    -fx-stroke-width: 1.7;
    -fx-stroke-line-join: round;
    -fx-stroke-line-cap: round;
}

.modal-title {
    -fx-text-fill: #111827;
    -fx-font-size: 19px;
    -fx-font-weight: bold;
}

.modal-text { -fx-text-fill: #4b5563; -fx-font-size: 13px; }

.success-halo { -fx-background-color: #dcfce7; -fx-background-radius: 42; }

.success-circle { -fx-background-color: #2e7d32; -fx-background-radius: 28; }

.success-check {
    -fx-fill: transparent;
    -fx-stroke: #ffffff;
    -fx-stroke-width: 2.6;
    -fx-stroke-line-cap: round;
    -fx-stroke-line-join: round;
}

.request-id {
    -fx-text-fill: #111827;
    -fx-font-size: 22px;
    -fx-font-weight: bold;
}

.timeline-dot {
    -fx-background-color: #ffffff;
    -fx-border-color: #d1d5db;
    -fx-border-width: 2;
    -fx-border-radius: 12;
    -fx-background-radius: 12;
}

.timeline-done { -fx-background-color: #2e7d32; -fx-border-color: #2e7d32; }

.timeline-current { -fx-border-color: #1f4e9c; }

.timeline-inner-dot { -fx-background-color: #1f4e9c; -fx-background-radius: 4; }

.timeline-check {
    -fx-fill: transparent;
    -fx-stroke: #ffffff;
    -fx-stroke-width: 2;
    -fx-stroke-line-cap: round;
}

.timeline-line { -fx-background-color: #d1d5db; }

.timeline-line-done { -fx-background-color: #2e7d32; }

.timeline-title {
    -fx-text-fill: #111827;
    -fx-font-size: 14px;
    -fx-font-weight: bold;
}