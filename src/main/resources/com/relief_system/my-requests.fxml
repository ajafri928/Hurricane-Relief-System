<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox styleClass="home-root" prefWidth="400.0" prefHeight="760.0" stylesheets="@styles.css, @account.css"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.relief_system.MyRequestsController">
   <children>
      <ScrollPane styleClass="home-scroll" fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS">
         <content>
            <VBox styleClass="home-content" spacing="14.0">
               <padding>
                  <Insets top="28.0" right="24.0" bottom="20.0" left="24.0" />
               </padding>
               <children>
                  <VBox spacing="4.0">
                     <children>
                        <Label text="My Requests" styleClass="page-title" />
                        <Label fx:id="summaryLabel" styleClass="flow-subheading" />
                     </children>
                  </VBox>
                  <HBox spacing="8.0">
                     <children>
                        <Button fx:id="allTab" text="All" styleClass="filter-tab, filter-tab-selected" maxWidth="Infinity" HBox.hgrow="ALWAYS" onAction="#showAll" />
                        <Button fx:id="activeTab" text="Active" styleClass="filter-tab" maxWidth="Infinity" HBox.hgrow="ALWAYS" onAction="#showActive" />
                        <Button fx:id="completedTab" text="Completed" styleClass="filter-tab" maxWidth="Infinity" HBox.hgrow="ALWAYS" onAction="#showCompleted" />
                     </children>
                  </HBox>
                  <VBox fx:id="cardList" spacing="12.0" />
                  <VBox fx:id="emptyState" styleClass="empty-card" spacing="8.0" alignment="CENTER" visible="false" managed="false">
                     <children>
                        <Label text="No requests yet" styleClass="empty-title" />
                        <Label fx:id="emptyBody" text="When you ask for help, your requests show up here." styleClass="empty-body" wrapText="true" />
                        <Button text="Request Help" styleClass="primary-button" maxWidth="Infinity" onAction="#requestHelp" />
                        <Label text="Find a shelter near me" styleClass="card-link" onMouseClicked="#findShelter" />
                     </children>
                  </VBox>
               </children>
            </VBox>
         </content>
      </ScrollPane>
      <fx:include fx:id="nav" source="nav.fxml" />
   </children>
</VBox>
