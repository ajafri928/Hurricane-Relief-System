<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox styleClass="home-root" prefWidth="400.0" prefHeight="760.0" stylesheets="@styles.css, @account.css"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.relief_system.ProfileController">
   <children>
      <ScrollPane styleClass="home-scroll" fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS">
         <content>
            <VBox styleClass="home-content" spacing="14.0">
               <padding>
                  <Insets top="28.0" right="24.0" bottom="20.0" left="24.0" />
               </padding>
               <children>
                  <Label text="Profile" styleClass="page-title" />

                  <HBox styleClass="white-card" alignment="CENTER_LEFT" spacing="12.0">
                     <children>
                        <StackPane styleClass="avatar" minWidth="44.0" minHeight="44.0" maxWidth="44.0" maxHeight="44.0">
                           <children>
                              <Label fx:id="initialsLabel" styleClass="avatar-text" />
                           </children>
                        </StackPane>
                        <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                           <children>
                              <Label fx:id="nameLabel" styleClass="section-title" />
                              <Label fx:id="usernameLabel" styleClass="hint" />
                           </children>
                        </VBox>
                        <Button text="Edit" styleClass="icon-button" onAction="#editProfile" />
                     </children>
                  </HBox>

                  <VBox styleClass="white-card" spacing="8.0">
                     <children>
                        <Label text="Your safety" styleClass="section-title" />
                        <HBox spacing="8.0">
                           <children>
                              <Button fx:id="safeButton" text="Safe" styleClass="chip-option" HBox.hgrow="ALWAYS" maxWidth="Infinity" onAction="#pickSafety" />
                              <Button fx:id="cautionButton" text="Caution" styleClass="chip-option" HBox.hgrow="ALWAYS" maxWidth="Infinity" onAction="#pickSafety" />
                           </children>
                        </HBox>
                        <HBox spacing="8.0">
                           <children>
                              <Button fx:id="highRiskButton" text="High risk" styleClass="chip-option" HBox.hgrow="ALWAYS" maxWidth="Infinity" onAction="#pickSafety" />
                              <Button fx:id="dangerButton" text="In danger" styleClass="chip-option" HBox.hgrow="ALWAYS" maxWidth="Infinity" onAction="#pickSafety" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>

                  <VBox styleClass="white-card" spacing="6.0">
                     <children>
                        <Label text="Contact and location" styleClass="section-title" />
                        <Label text="Phone" styleClass="hint" />
                        <Label fx:id="phoneLabel" styleClass="field-heading" />
                        <Label text="Home address" styleClass="hint" />
                        <Label fx:id="addressLabel" styleClass="field-heading" wrapText="true" />
                     </children>
                  </VBox>

                  <VBox styleClass="white-card" spacing="8.0">
                     <children>
                        <HBox alignment="CENTER_LEFT">
                           <children>
                              <Label text="Emergency contacts" styleClass="section-title" HBox.hgrow="ALWAYS" maxWidth="Infinity" />
                              <Label text="Add" styleClass="card-link" onMouseClicked="#addContact" />
                           </children>
                        </HBox>
                        <VBox fx:id="contactList" spacing="8.0" />
                        <Label fx:id="noContactsLabel" text="No emergency contacts yet." styleClass="hint" />
                     </children>
                  </VBox>

                  <Button text="Sign out" styleClass="secondary-button" maxWidth="Infinity" onAction="#signOut" />
               </children>
            </VBox>
         </content>
      </ScrollPane>
      <fx:include fx:id="nav" source="nav.fxml" />
   </children>
</VBox>
