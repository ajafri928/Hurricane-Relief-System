<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<VBox styleClass="home-root" prefWidth="400.0" prefHeight="760.0" stylesheets="@styles.css"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.relief_system.RequestSubmittedController">
   <children>
      <ScrollPane styleClass="home-scroll" fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS">
         <content>
            <VBox styleClass="home-content" alignment="TOP_CENTER" spacing="12.0">
               <padding>
                  <Insets top="36.0" right="24.0" bottom="20.0" left="24.0" />
               </padding>
               <children>
                  <StackPane styleClass="success-halo" prefWidth="84.0" prefHeight="84.0" maxWidth="84.0" maxHeight="84.0">
                     <children>
                        <StackPane styleClass="success-circle" prefWidth="56.0" prefHeight="56.0" maxWidth="56.0" maxHeight="56.0">
                           <children>
                              <SVGPath styleClass="success-check" content="M2 9 L7.5 14.5 L18 3.5" />
                           </children>
                        </StackPane>
                     </children>
                  </StackPane>

                  <Label text="Request submitted" styleClass="flow-heading" />
                  <Label text="A volunteer will be matched to your request soon. We'll text you updates."
                         styleClass="section-body" wrapText="true" textAlignment="CENTER" maxWidth="300.0" />

                  <HBox styleClass="white-card" alignment="CENTER_LEFT" maxWidth="Infinity">
                     <VBox.margin><Insets top="8.0" /></VBox.margin>
                     <children>
                        <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                           <children>
                              <Label text="Request ID" styleClass="hint" />
                              <Label fx:id="requestIdLabel" text="#LL-20481" styleClass="request-id" />
                           </children>
                        </VBox>
                        <HBox styleClass="status-chip, chip-pending, chip-small" alignment="CENTER_LEFT" spacing="6.0">
                           <children>
                              <SVGPath styleClass="chip-icon" content="M7 1 A6 6 0 1 0 7 13 A6 6 0 1 0 7 1 Z M7 4 V7 L9.5 8.5" />
                              <Label text="Pending match" styleClass="chip-text" />
                           </children>
                        </HBox>
                     </children>
                  </HBox>

                  <VBox spacing="0.0" maxWidth="Infinity">
                     <VBox.margin><Insets top="8.0" /></VBox.margin>
                     <children>
                        <Label text="What happens next" styleClass="field-heading">
                           <VBox.margin><Insets bottom="10.0" /></VBox.margin>
                        </Label>
                        <HBox spacing="12.0">
                           <children>
                              <VBox alignment="TOP_CENTER" minWidth="24.0">
                                 <children>
                                    <StackPane styleClass="timeline-dot, timeline-done" prefWidth="24.0" prefHeight="24.0" maxWidth="24.0" maxHeight="24.0">
                                       <children><SVGPath styleClass="timeline-check" content="M1 5 L4 8 L10 1.5" /></children>
                                    </StackPane>
                                    <Region styleClass="timeline-line, timeline-line-done" prefHeight="28.0" prefWidth="2.0" maxWidth="2.0" />
                                 </children>
                              </VBox>
                              <VBox spacing="2.0">
                                 <children>
                                    <Label text="Request submitted" styleClass="timeline-title" />
                                    <Label fx:id="submittedTimeLabel" text="Today at 9:41 PM" styleClass="hint" />
                                 </children>
                              </VBox>
                           </children>
                        </HBox>
                        <HBox spacing="12.0">
                           <children>
                              <VBox alignment="TOP_CENTER" minWidth="24.0">
                                 <children>
                                    <StackPane styleClass="timeline-dot, timeline-current" prefWidth="24.0" prefHeight="24.0" maxWidth="24.0" maxHeight="24.0">
                                       <children><Region styleClass="timeline-inner-dot" prefWidth="8.0" prefHeight="8.0" maxWidth="8.0" maxHeight="8.0" /></children>
                                    </StackPane>
                                    <Region styleClass="timeline-line" prefHeight="28.0" prefWidth="2.0" maxWidth="2.0" />
                                 </children>
                              </VBox>
                              <VBox spacing="2.0">
                                 <children>
                                    <Label text="Volunteer matched" styleClass="timeline-title" />
                                    <Label text="Usually within 2-6 hours" styleClass="hint" />
                                 </children>
                              </VBox>
                           </children>
                        </HBox>
                        <HBox spacing="12.0">
                           <children>
                              <VBox alignment="TOP_CENTER" minWidth="24.0">
                                 <children>
                                    <StackPane styleClass="timeline-dot" prefWidth="24.0" prefHeight="24.0" maxWidth="24.0" maxHeight="24.0" />
                                 </children>
                              </VBox>
                              <VBox spacing="2.0">
                                 <children>
                                    <Label text="Help on the way" styleClass="timeline-title" />
                                    <Label text="You'll get an update with their ETA" styleClass="hint" />
                                 </children>
                              </VBox>
                           </children>
                        </HBox>
                     </children>
                  </VBox>

                  <Button text="View My Request" styleClass="primary-button" maxWidth="Infinity" onAction="#handleViewRequest">
                     <VBox.margin><Insets top="14.0" /></VBox.margin>
                  </Button>
                  <Label text="Back to Home" styleClass="card-link" onMouseClicked="#handleBackToHome" />
               </children>
            </VBox>
         </content>
      </ScrollPane>

      <fx:include fx:id="nav" source="nav.fxml" />
   </children>
</VBox>